# Copy to .env.local and fill in your Neon/Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Quiz master login password
ADMIN_PASSWORD=change-me

# Only needed when the Next.js app and the Socket.IO server (server/index.js) run on
# different hosts (e.g. Next.js on Vercel, server/index.js on Railway/Render/Fly.io).
# Leave unset for local development (both default to http://localhost:3001).
SOCKET_SERVER_URL=https://your-socket-server.example.com
NEXT_PUBLIC_SOCKET_SERVER_URL=https://your-socket-server.example.com
